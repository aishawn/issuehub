APP_ENV=development
APP_DB=teamai.db
# PostgreSQL URL used by Docker Compose and optional local PostgreSQL development.
# URL-encode reserved characters in usernames/passwords (for example @ as %40).
DATABASE_URL=postgresql://teamai:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/teamai
APP_HOST=127.0.0.1
APP_PORT=8787
# Keep loopback for local-only use. For a controlled LAN test, set to 0.0.0.0
# and restrict inbound TCP/8787 to the tester subnet in the host firewall.
TEAMAI_BIND_ADDRESS=127.0.0.1
SYNC_INTERVAL_SECONDS=60
TEAMAI_API_KEY=
# Comma-separated usernames (case-insensitive) that can open admin Web pages:
# knowledge review leftovers, GitLab sync retry, and user activity.
# Example: TEAMAI_ADMIN_USERS=admin,alice
TEAMAI_ADMIN_USERS=admin
# In production, configure these using headers overwritten by your trusted SSO proxy.
# Manual knowledge publish (admin leftover queue) still checks the approver group.
TEAMAI_REVIEWER_ID_HEADER=X-Authenticated-User
TEAMAI_REVIEWER_GROUPS_HEADER=X-Authenticated-Groups
TEAMAI_REVIEWER_REQUIRED_GROUP=teamai-approvers
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
POSTGRES_DB=teamai
POSTGRES_USER=teamai
POSTGRES_PASSWORD=
MINIO_ROOT_USER=teamai
MINIO_ROOT_PASSWORD=
ATTACHMENT_BUCKET=teamai-attachments
ATTACHMENT_MAX_BYTES=20971520
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=teamai
S3_SECRET_KEY=
S3_SECURE=false
